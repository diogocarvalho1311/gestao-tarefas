# O único segredo necessário. Copie a credencial da integração do Notion.
NOTION_TOKEN=

# Fonte real “📋 Tarefas”, identificada na sua integração.
# Deixe vazio para detectar automaticamente, se houver uma única base de tarefas.
# Também aceita o ID da base de dados copiado da URL do Notion.
NOTION_DATA_SOURCE_ID=38e9cd3e-bf24-815f-b168-000b1c06c60c

# OPCIONAIS — não é necessário preencher os campos abaixo.
# Nome, Cliente, Data, Status e Área são detectados pelo esquema da base.
# Essa base não tem Prioridade: as tarefas começam em Média, editável localmente.
# NOTION_TITLE_PROPERTY=Nome
# NOTION_CLIENT_PROPERTY=Cliente
# NOTION_DUE_PROPERTY=Data
# NOTION_STATUS_PROPERTY=Status
# NOTION_AREA_PROPERTY=Área
# NOTION_ASSIGNEE_ID=
# NOTION_ASSIGNEE_PROPERTY=Responsável
# PORT=3000
# DATABASE_PATH=C:/caminho/local/compasso.sqlite
